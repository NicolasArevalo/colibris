---
import tipiImg from '../img/tipi.jpeg'
import fogataImg from '../img/fogata.png'
import senderismoImg from '../img/senderismo.jpeg'
import pizzaImg from '../img/pizza.jpeg'
import parqueaderoImg from '../img/parqueadero.jpeg'
import consultaImg from '../img/consulta.jpeg'

const services = [
	{
		title: 'Temazcal y Rituales de Naturaleza',
		description:
			'Espacios sagrados para el renacer. Guiamos ceremonias tradicionales de temazcal y rituales en profunda conexión con los elementos y espíritus de la naturaleza.',
		image: fogataImg.src,
	},
	{
		title: 'Retiros y Conexión Interior',
		description:
			'Encuentra tu centro. Ofrecemos retiros personalizados, acompañamiento en procesos de ayuno profundo, sauna, y espacios seguros para tu fluir creativo.',
		image: tipiImg.src,
	},
	{
		title: 'Eventos, Comida y Celebraciones',
		description:
			'Reuniones con sentido. Acogemos desde reuniones empresariales diferentes hasta celebraciones íntimas. Disfruta de nuestra cocina regenerativa (¡como nuestra deliciosa paella local!).',
		image: pizzaImg.src,
	},
	{
		title: 'Senderismo y Excursiones',
		description:
			'Sumérgete en el ecosistema. Organizamos caminatas guiadas por el bosque tupido y preciosas excursiones contemplativas hacia el pantano de Alocén.',
		image: senderismoImg.src,
	},
	{
		title: 'Hospedaje, Camping y RVs',
		description:
			'Despierta con el susurro del viento. Disponemos de zonas seguras y equipadas para acampar, estacionar tu furgoneta o descansar placenteramente en nuestros cálidos alojamientos.',
		image: parqueaderoImg.src,
	},
	{
		title: 'Fisioterapia y Osteopatía',
		description:
			'Sanación profunda para tu vehículo físico. Terapias profesionales rigurosas orientadas a liberar tensiones estructurales, aliviar dolor crónico y restaurar la movilidad.',
		image: consultaImg.src,
	},
]
---

<section id='servicios' class='py-16 md:py-24 bg-stone-100'>
	<div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
		<div class='text-center max-w-3xl mx-auto mb-16'>
			<h2
				class='text-teal-600 font-semibold tracking-wide uppercase text-sm mb-2'
			>
				Tratamientos y Experiencias
			</h2>
			<h3 class='text-4xl font-serif text-stone-900 mb-4'>
				Servicios para el cuerpo, mente y alma
			</h3>
			<p class='text-stone-600 text-lg'>
				En La Casa de los Colibrís hemos tejido una red de actividades y
				terapias diseñadas para acompañarte en tu proceso de relajación,
				sanación y reconexión profunda.
			</p>
		</div>

		<div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10'>
			{
				services.map(service => (
					<div class='bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-300 border border-stone-200 group flex flex-col h-full'>
						<div class='relative h-64 overflow-hidden bg-stone-200'>
							<img
								src={service.image}
								alt={service.title}
								class='w-full h-full object-cover transition-transform duration-700 group-hover:scale-110'
								loading='lazy'
								onerror="this.src='https://placehold.co/800x600/e2e8f0/475569?text=Imagen+Pronto'"
							/>
							<div class='absolute inset-0 bg-stone-900/10 group-hover:bg-transparent transition-colors duration-300' />
						</div>
						<div class='p-8 flex flex-col flex-grow'>
							<h4 class='text-2xl font-serif font-semibold text-stone-900 mb-4 group-hover:text-teal-700 transition-colors'>
								{service.title}
							</h4>
							<p class='text-stone-600 leading-relaxed flex-grow'>
								{service.description}
							</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
