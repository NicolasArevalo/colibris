---
import { Image } from 'astro:assets'
import heroImg from '../img/ViewW2.png'
---

<section
	id='inicio'
	class='relative h-screen flex items-center justify-center overflow-hidden'
>
	<div class='absolute inset-0 z-0'>
		<Image
			src={heroImg}
			alt='Vista de La Casa de los Colibrís'
			class='w-full h-full object-cover object-center'
			loading='eager'
			fetchpriority='high'
			quality={'high'}
		/>
		<div class='absolute inset-0 bg-stone-900/40 mix-blend-multiply'></div>
		<div
			class='absolute inset-0 bg-gradient-to-t from-stone-50 via-transparent to-transparent'
		>
		</div>
	</div>

	<div class='relative z-10 text-center px-4 max-w-4xl mx-auto mt-20'>
		<div
			class='inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-white/20 bg-white/10 backdrop-blur-md mb-6 shadow-lg'
		>
			<span class='w-1.5 h-1.5 rounded-full bg-teal-400'></span>
			<span
				class='text-xs md:text-sm font-medium tracking-[0.2em] text-stone-200 uppercase'
				>Salud y Reposo • Alocén, España</span
			>
		</div>
		<h1
			class='text-5xl md:text-7xl font-serif font-semibold text-white tracking-tight drop-shadow-lg'
		>
			La Casa de los Colibrís
		</h1>
		<p
			class='text-xl md:text-2xl text-stone-100 mb-10 text-balance max-w-2xl mx-auto drop-shadow-md font-light'
		>
			Un refugio para eventos, comida, descanso, relajación y
			espiritualidad en armonía con la naturaleza.
		</p>
		<div
			class='flex flex-col sm:flex-row gap-4 sm:gap-6 justify-center items-center'
		>
			<a
				href='#servicios'
				class='inline-flex justify-center items-center px-8 py-3.5 bg-teal-600 hover:bg-teal-500 text-white rounded-full font-medium transition-all duration-300 transform hover:-translate-y-1 shadow-[0_0_20px_rgba(13,148,136,0.3)] hover:shadow-[0_0_30px_rgba(13,148,136,0.5)] w-full max-w-[280px] sm:w-auto ring-1 ring-teal-500/50'
			>
				Descubre nuestros servicios
			</a>
			<div class='flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto px-4 sm:px-0'>
				<a
					href='#contacto'
					class='flex flex-1 justify-center items-center px-8 py-3.5 bg-white/10 hover:bg-white/20 backdrop-blur-md text-white border border-white/30 rounded-full font-medium transition-all duration-300 transform hover:-translate-y-1 w-full max-w-[280px] sm:w-auto shadow-lg hover:shadow-white/10'
				>
					Contáctanos
				</a>
				<a
					href='https://www.instagram.com/lacasadeloscolibris1/'
					target='_blank'
					rel='noopener noreferrer'
					aria-label='Síguenos en Instagram'
					class='inline-flex justify-center items-center p-3.5 bg-white/10 hover:bg-white/20 backdrop-blur-md text-white border border-white/30 rounded-full transition-all duration-300 transform hover:-translate-y-1 shadow-lg hover:shadow-white/10'
				>
					<svg class='w-6 h-6' fill='currentColor' viewBox='0 0 24 24'
						><path
							d='M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z'
						></path></svg
					>
				</a>
			</div>
		</div>
	</div>
</section>
