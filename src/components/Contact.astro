---

---

<section id='contacto' class='py-16 md:py-24 bg-stone-900 text-stone-100'>
	<div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
		<div class='grid grid-cols-1 lg:grid-cols-2 gap-16'>
			<div>
				<h2
					class='text-teal-400 font-semibold tracking-wide uppercase text-sm mb-2'
				>
					Hablemos
				</h2>
				<h3 class='text-4xl font-serif text-white mb-6'>Reserva tu espacio</h3>
				<p class='text-stone-400 text-lg mb-10'>
					Ya sea que busques acampar bajo las estrellas, organizar un retiro
					consciente o simplemente escapar por un fin de semana. Estamos aquí
					para ti.
				</p>

				<div class='space-y-6'>
					<div class='flex items-start gap-4'>
						<div class='mt-1 bg-stone-800 p-3 rounded-full text-teal-400'>
							<svg
								class='w-6 h-6'
								fill='none'
								viewBox='0 0 24 24'
								stroke='currentColor'
							>
								<path
									stroke-linecap='round'
									stroke-linejoin='round'
									stroke-width='1.5'
									d='M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z'
								></path>
								<path
									stroke-linecap='round'
									stroke-linejoin='round'
									stroke-width='1.5'
									d='M15 11a3 3 0 11-6 0 3 3 0 016 0z'></path>
							</svg>
						</div>
						<div class='w-full'>
							<h4 class='text-white font-medium mb-1'>Ubicación</h4>
							<p class='text-stone-400 mb-6'>
								La casa de los colibrís<br />A pocos minutos de Alocén,
								Guadalajara.
							</p>

							<div
								class='w-full h-64 rounded-xl overflow-hidden border border-stone-700 shadow-lg'
							>
								<iframe
									src='https://maps.google.com/maps?q=Aloc%C3%A9n,%20Guadalajara,%20Spain&t=&z=13&ie=UTF8&iwloc=&output=embed'
									width='100%'
									height='100%'
									style='border:0;'
									allowfullscreen=''
									loading='lazy'
									referrerpolicy='no-referrer-when-downgrade'
								>
								</iframe>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class='flex flex-col justify-center'>
				<div
					class='relative bg-stone-800/80 backdrop-blur-md p-8 md:p-10 rounded-[2rem] border border-stone-700/50 shadow-2xl overflow-hidden'
				>
					{/* Elementos decorativos */}
					<div class='absolute -top-24 -right-24 w-64 h-64 bg-teal-500/10 rounded-full blur-3xl'></div>
					<div class='absolute -bottom-24 -left-24 w-64 h-64 bg-teal-500/10 rounded-full blur-3xl'></div>

					<div class='relative z-10'>
						<div class='mb-8 text-center'>
							<h4 class='text-2xl font-serif text-white mb-3'>Inicia tu reserva</h4>
							<p class='text-stone-400 text-sm md:text-base'>
								Escríbenos por tu medio favorito. Te atenderemos detalladamente para organizar tu estancia o retiro.
							</p>
						</div>

						<div class='space-y-4'>
							<a
								href='mailto:lacasadeloscolibris1@gmail.com'
								class='group flex items-center justify-between w-full bg-stone-900/50 hover:bg-white text-stone-300 hover:text-stone-900 p-4 rounded-2xl border border-stone-700 hover:border-white transition-all duration-300 shadow-lg hover:shadow-xl hover:-translate-y-1 overflow-hidden'
							>
								<div class='flex items-center gap-4 relative z-10'>
									<div class='bg-stone-800 group-hover:bg-stone-100 p-3 rounded-xl transition-colors'>
										<svg
											class='w-6 h-6 text-stone-400 group-hover:text-teal-600 transition-colors'
											fill='none'
											viewBox='0 0 24 24'
											stroke='currentColor'
										>
											<path
												stroke-linecap='round'
												stroke-linejoin='round'
												stroke-width='1.5'
												d='M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'
											></path>
										</svg>
									</div>
									<span class='font-medium text-lg'>Correo Electrónico</span>
								</div>
								<svg class='w-5 h-5 opacity-0 -translate-x-4 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 text-teal-600 relative z-10' fill='none' viewBox='0 0 24 24' stroke='currentColor'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M14 5l7 7m0 0l-7 7m7-7H3'></path></svg>
							</a>

							<a
								href='https://wa.me/34626980149'
								target='_blank'
								rel='noopener noreferrer'
								class='group flex items-center justify-between w-full bg-[#25D366]/10 hover:bg-[#25D366] text-[#25D366] hover:text-white p-4 rounded-2xl border border-[#25D366]/30 hover:border-[#25D366] transition-all duration-300 shadow-lg hover:shadow-xl hover:shadow-[#25D366]/20 hover:-translate-y-1'
							>
								<div class='flex items-center gap-4 relative z-10'>
									<div class='bg-[#25D366]/20 group-hover:bg-white/20 p-3 rounded-xl transition-colors'>
										<svg class='w-6 h-6' fill='currentColor' viewBox='0 0 24 24'>
											<path
												d='M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z'
											></path>
										</svg>
									</div>
									<span class='font-medium text-lg'>WhatsApp</span>
								</div>
								<svg class='w-5 h-5 opacity-0 -translate-x-4 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 text-white relative z-10' fill='none' viewBox='0 0 24 24' stroke='currentColor'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M14 5l7 7m0 0l-7 7m7-7H3'></path></svg>
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
