---
const currentYear = new Date().getFullYear();
---
<footer class="bg-stone-900 text-stone-300 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-center gap-8">
      <div class="text-center md:text-left">
        <h3 class="text-2xl font-serif font-semibold text-white mb-3">La casa de los colibrís</h3>
        <p class="text-sm text-stone-400 max-w-sm">
          Un espacio de paz, eventos, descanso, relajación y espiritualidad en conexión con la naturaleza.
        </p>
      </div>
      
      <div class="flex space-x-6">
        <a href="#inicio" class="hover:text-teal-400 transition-colors">Inicio</a>
        <a href="#servicios" class="hover:text-teal-400 transition-colors">Servicios</a>
        <a href="#hosts" class="hover:text-teal-400 transition-colors">Nosotros</a>
        <a href="#contacto" class="hover:text-teal-400 transition-colors">Contacto</a>
      </div>
    </div>
    
    <div class="mt-12 pt-8 border-t border-stone-800 text-center text-sm text-stone-500">
      &copy; {currentYear} La casa de los colibrís. Todos los derechos reservados.
    </div>
  </div>
</footer>
