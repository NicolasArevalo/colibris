---

---

<header
	class='fixed w-full top-0 z-50 transition-all duration-300 bg-white/80 backdrop-blur-md shadow-sm'
>
	<div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
		<div class='flex justify-between items-center h-20'>
			<div class='flex-shrink-0 flex items-center'>
				<a
					href='#inicio'
					class='text-2xl font-serif font-semibold text-teal-800 tracking-tight flex items-center gap-2'
				>
					La casa de los colibrís
				</a>
			</div>
			<nav class='hidden md:flex space-x-8'>
				<a
					href='#inicio'
					class='text-stone-600 hover:text-teal-600 transition-colors duration-200 text-sm font-medium uppercase tracking-wider'
					>Inicio</a
				>
				<a
					href='#servicios'
					class='text-stone-600 hover:text-teal-600 transition-colors duration-200 text-sm font-medium uppercase tracking-wider'
					>Servicios</a
				>
				<a
					href='#productos'
					class='text-stone-600 hover:text-teal-600 transition-colors duration-200 text-sm font-medium uppercase tracking-wider'
					>Productos</a
				>
				<a
					href='#hosts'
					class='text-stone-600 hover:text-teal-600 transition-colors duration-200 text-sm font-medium uppercase tracking-wider'
					>Nosotros</a
				>
				<a
					href='#contacto'
					class='text-stone-600 hover:text-teal-600 transition-colors duration-200 text-sm font-medium uppercase tracking-wider'
					>Contacto</a
				>
				<a
					href='https://www.instagram.com/lacasadeloscolibris1/'
					target='_blank'
					rel='noopener noreferrer'
					class='text-stone-600 hover:text-[#E1306C] transition-colors duration-200 flex items-center'
					aria-label='Instagram'
				>
					<svg class='w-5 h-5' fill='currentColor' viewBox='0 0 24 24'><path d='M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z'/></svg>
				</a>
			</nav>
			<!-- Mobile menu button -->
			<div class='md:hidden flex items-center'>
				<button
					id='mobile-menu-btn'
					class='text-stone-600 hover:text-teal-600 focus:outline-none'
				>
					<svg
						class='h-6 w-6'
						fill='none'
						viewBox='0 0 24 24'
						stroke='currentColor'
					>
						<path
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'
							d='M4 6h16M4 12h16M4 18h16'></path>
					</svg>
				</button>
			</div>
		</div>
	</div>

	<!-- Mobile Menu -->
	<div
		id='mobile-menu'
		class='hidden md:hidden bg-white/95 backdrop-blur-md absolute w-full border-t border-stone-100 shadow-lg'
	>
		<div class='px-2 pt-2 pb-3 space-y-1 sm:px-3 flex flex-col items-center'>
			<a
				href='#inicio'
				class='block px-3 py-2 text-stone-600 hover:text-teal-600 font-medium uppercase tracking-wider mobile-link'
				>Inicio</a
			>
			<a
				href='#servicios'
				class='block px-3 py-2 text-stone-600 hover:text-teal-600 font-medium uppercase tracking-wider mobile-link'
				>Servicios</a
			>
			<a
				href='#productos'
				class='block px-3 py-2 text-stone-600 hover:text-teal-600 font-medium uppercase tracking-wider mobile-link'
				>Productos</a
			>
			<a
				href='#hosts'
				class='block px-3 py-2 text-stone-600 hover:text-teal-600 font-medium uppercase tracking-wider mobile-link'
				>Nosotros</a
			>
			<a
				href='#contacto'
				class='block px-3 py-2 text-stone-600 hover:text-teal-600 font-medium uppercase tracking-wider mobile-link'
				>Contacto</a
			>
			<a
				href='https://www.instagram.com/lacasadeloscolibris1/'
				target='_blank'
				rel='noopener noreferrer'
				class='flex items-center gap-2 px-3 py-2 text-stone-600 hover:text-[#E1306C] font-medium uppercase tracking-wider'
			>
				<svg class='w-5 h-5' fill='currentColor' viewBox='0 0 24 24'><path d='M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z'/></svg>
				<span class="text-sm">Instagram</span>
			</a>
		</div>
	</div>
</header>

<script>
	const btn = document.getElementById('mobile-menu-btn')
	const menu = document.getElementById('mobile-menu')
	const links = document.querySelectorAll('.mobile-link')

	btn?.addEventListener('click', () => {
		menu?.classList.toggle('hidden')
	})

	links.forEach(link => {
		link.addEventListener('click', () => {
			menu?.classList.add('hidden')
		})
	})
</script>
