---

---

<header
	class='fixed w-full top-0 z-50 transition-all duration-300 bg-white/80 backdrop-blur-md shadow-sm'
>
	<div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
		<div class='flex justify-between items-center h-20'>
			<div class='flex-shrink-0 flex items-center'>
				<a
					href='#inicio'
					class='text-2xl font-serif font-semibold text-teal-800 tracking-tight flex items-center gap-2'
				>
					La casa de los colibrís
				</a>
			</div>
			<nav class='hidden md:flex space-x-8'>
				<a
					href='#inicio'
					class='text-stone-600 hover:text-teal-600 transition-colors duration-200 text-sm font-medium uppercase tracking-wider'
					>Inicio</a
				>
				<a
					href='#servicios'
					class='text-stone-600 hover:text-teal-600 transition-colors duration-200 text-sm font-medium uppercase tracking-wider'
					>Servicios</a
				>
				<a
					href='#productos'
					class='text-stone-600 hover:text-teal-600 transition-colors duration-200 text-sm font-medium uppercase tracking-wider'
					>Productos</a
				>
				<a
					href='#hosts'
					class='text-stone-600 hover:text-teal-600 transition-colors duration-200 text-sm font-medium uppercase tracking-wider'
					>Nosotros</a
				>
				<a
					href='#contacto'
					class='text-stone-600 hover:text-teal-600 transition-colors duration-200 text-sm font-medium uppercase tracking-wider'
					>Contacto</a
				>
			</nav>
			<!-- Mobile menu button -->
			<div class='md:hidden flex items-center'>
				<button
					id='mobile-menu-btn'
					class='text-stone-600 hover:text-teal-600 focus:outline-none'
				>
					<svg
						class='h-6 w-6'
						fill='none'
						viewBox='0 0 24 24'
						stroke='currentColor'
					>
						<path
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'
							d='M4 6h16M4 12h16M4 18h16'></path>
					</svg>
				</button>
			</div>
		</div>
	</div>

	<!-- Mobile Menu -->
	<div
		id='mobile-menu'
		class='hidden md:hidden bg-white/95 backdrop-blur-md absolute w-full border-t border-stone-100 shadow-lg'
	>
		<div class='px-2 pt-2 pb-3 space-y-1 sm:px-3 flex flex-col items-center'>
			<a
				href='#inicio'
				class='block px-3 py-2 text-stone-600 hover:text-teal-600 font-medium uppercase tracking-wider mobile-link'
				>Inicio</a
			>
			<a
				href='#servicios'
				class='block px-3 py-2 text-stone-600 hover:text-teal-600 font-medium uppercase tracking-wider mobile-link'
				>Servicios</a
			>
			<a
				href='#productos'
				class='block px-3 py-2 text-stone-600 hover:text-teal-600 font-medium uppercase tracking-wider mobile-link'
				>Productos</a
			>
			<a
				href='#hosts'
				class='block px-3 py-2 text-stone-600 hover:text-teal-600 font-medium uppercase tracking-wider mobile-link'
				>Nosotros</a
			>
			<a
				href='#contacto'
				class='block px-3 py-2 text-stone-600 hover:text-teal-600 font-medium uppercase tracking-wider mobile-link'
				>Contacto</a
			>
		</div>
	</div>
</header>

<script>
	const btn = document.getElementById('mobile-menu-btn')
	const menu = document.getElementById('mobile-menu')
	const links = document.querySelectorAll('.mobile-link')

	btn?.addEventListener('click', () => {
		menu?.classList.toggle('hidden')
	})

	links.forEach(link => {
		link.addEventListener('click', () => {
			menu?.classList.add('hidden')
		})
	})
</script>
